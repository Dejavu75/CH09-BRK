  "openapi": "3.0.3",
  "info": {
    "title": "CH09-BRK AGES Broker API",
    "version": "1.0.0",
    "description": "Exportado desde habitat/CH09-BRK. Incluye montajes /foreign/broker y /ages; los comodines AGES quedan como requests parametrizadas."
  },
  "servers": [
    {
      "url": "{fullhost}",
      "description": "fullhost = protocolo + host + puerto",
      "variables": {
        "fullhost": {
          "default": "http://localhost:41048"
        },
        "protocolo": {
          "default": "http://"
        },
        "host": {
          "default": "localhost"
        },
        "puerto": {
          "default": ":41048"
        }
      }
    }
  ],
